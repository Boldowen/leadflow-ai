generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

model User {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  passwordHash   String
  /// The first ADMIN is granted with `npm run admin`; admins can then manage roles in /admin.
  role           Role     @default(USER)
  /// Embedded in the session token; bumping it signs the user out everywhere.
  sessionVersion Int      @default(0)
  createdAt      DateTime @default(now())
  leads          Lead[]

  // Automation: public form key + optional integrations
  formKey             String               @unique @default(cuid())
  telegramBotToken    String?
  telegramChatId      String?
  sheetsWebhookUrl    String?
  automationRuns      AutomationRun[]
  aiCalls             AiCall[]
  passwordResetTokens PasswordResetToken[]
  auditLogs           AuditLog[]
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  WON
  LOST
}

enum LeadTemperature {
  HOT
  WARM
  COLD
}

model Lead {
  id      String     @id @default(cuid())
  name    String
  email   String
  company String?
  message String     @default("")
  notes   String     @default("")
  status  LeadStatus @default(NEW)
  source  String     @default("manual")

  // AI analysis (filled by /analyze)
  aiSummary     String?
  aiTemperature LeadTemperature?
  /// 0–100, always inside the temperature's band (Hot 70–100, Warm 40–69, Cold 0–39)
  aiScore       Int?
  aiNextAction  String?
  aiModel       String?
  analyzedAt    DateTime?

  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  automationRuns AutomationRun[]

  @@index([ownerId, createdAt])
}

enum RunStatus {
  SUCCESS
  PARTIAL
  FAILED
}

/// One execution of the website-form workflow: AI → Sheets → Telegram.
model AutomationRun {
  id        String    @id @default(cuid())
  status    RunStatus
  /// [{ step, status: "ok" | "skipped" | "failed", detail?, ms }]
  steps     Json
  ownerId   String
  owner     User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  leadId    String?
  lead      Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  createdAt DateTime  @default(now())

  @@index([ownerId, createdAt])
}

/// One real (non-mock) Claude call — used for per-user and global rate limits.
model AiCall {
  id        String   @id @default(cuid())
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([ownerId, createdAt])
  @@index([createdAt])
}

/// Single-use password reset link. Only the SHA-256 of the token is stored.
model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// Fixed-window rate limit counters shared by all serverless instances.
model RateLimitHit {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
  @@index([createdAt])
}

/// Admin actions. Emails are copied so the log survives deleted accounts.
model AuditLog {
  id          String   @id @default(cuid())
  actorId     String?
  actor       User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorEmail  String
  action      String
  targetEmail String?
  detail      String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
}
