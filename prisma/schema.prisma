generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  leads        Lead[]

  // Automation: public form key + optional integrations
  formKey          String  @unique @default(cuid())
  telegramBotToken String?
  telegramChatId   String?
  sheetsWebhookUrl String?
  automationRuns   AutomationRun[]
  aiCalls          AiCall[]
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  WON
  LOST
}

enum LeadTemperature {
  HOT
  WARM
  COLD
}

model Lead {
  id        String     @id @default(cuid())
  name      String
  email     String
  company   String?
  message   String     @default("")
  notes     String     @default("")
  status    LeadStatus @default(NEW)
  source    String     @default("manual")

  // AI analysis (filled by /analyze)
  aiSummary     String?
  aiTemperature LeadTemperature?
  aiNextAction  String?
  aiModel       String?
  analyzedAt    DateTime?

  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  automationRuns AutomationRun[]

  @@index([ownerId, createdAt])
}

enum RunStatus {
  SUCCESS
  PARTIAL
  FAILED
}

/// One execution of the website-form workflow: AI → Sheets → Telegram.
model AutomationRun {
  id        String    @id @default(cuid())
  status    RunStatus
  /// [{ step, status: "ok" | "skipped" | "failed", detail?, ms }]
  steps     Json
  ownerId   String
  owner     User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  leadId    String?
  lead      Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  createdAt DateTime  @default(now())

  @@index([ownerId, createdAt])
}

/// One real (non-mock) Claude call — used for per-user and global rate limits.
model AiCall {
  id        String   @id @default(cuid())
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([ownerId, createdAt])
  @@index([createdAt])
}
